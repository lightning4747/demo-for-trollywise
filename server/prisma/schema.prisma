datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  demoRequests DemoRequest[]
}

model DemoRequest {
  id                Int      @id @default(autoincrement())
  userId            Int
  user              User     @relation(fields: [userId], references: [id])
  businessName      String
  storeAddress      String
  phone             String
  status            String   @default("pending_payment") // pending_payment | confirmed
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime @default(now())
}
